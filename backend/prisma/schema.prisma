// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id     String @id @default(uuid())
  firstname String
  lastname String
  email String @unique
  password String
  role Role @default(BASIC_USER)
  lastConnectedCompanyId String?

  lastConnectedCompany Company? @relation("LastConnectedCompany", fields: [lastConnectedCompanyId], references: [id])
  ownedCompanies Company[]
  companies CompanyUser[]
}

enum Role {
  BASIC_USER
  PREMIUM_USER
  PRO_USER
  ADMIN_USER
}

model Company {
  id String @id @default(uuid())
  ownerId String
  name String
  email String @unique
  phoneNumber String @unique
  siren String @unique
  siret String @unique
  address String
  city String
  postalCode String
  country String
  subjectToVat Boolean
  vatNumber String?
  IBAN String
  BIC String
  status CompanyStatus @default(ACTIVE)
  closingReason String?
  closedAt DateTime?
  isPaymentAccountConnected Boolean @default(false)

  documents Document[]
  owner User @relation(fields: [ownerId], references: [id])
  companyUsers CompanyUser[]
  lastConnectedUsers User[] @relation("LastConnectedCompany")
  invoicePaymentFees InvoicePaymentFee[]

  services CompanyService[]
  clients CompanyClient[]
  companyPaymentAccounts CompanyPaymentAccount[]
  companyPaymentOAuthStates CompanyPaymentOAuthState[]
}

enum CompanyStatus {
  ACTIVE
  CLOSED
}

model CompanyPaymentAccount {
  id String @id @default(uuid())
  companyId String
  provider PaymentProvider
  providerAccountId String
  accessToken String
  creditorId String?
  verificationStatus CompanyPaymentAccountVerificationStatus @default(NOT_VERIFIED)

  company Company @relation(fields: [companyId], references: [id])
}

enum CompanyPaymentAccountVerificationStatus {
  NOT_VERIFIED
  IN_REVIEW
  VERIFIED
}

model CompanyPaymentOAuthState {
  id String @id @default(uuid())
  companyId String
  state String @unique
  expiresAt DateTime

  company Company @relation(fields: [companyId], references: [id])
}
model CompanyUser {
  id String @id @default(uuid())
  companyId String
  userId String
  role CompanyUserRole
  isHidden Boolean @default(false)

  company Company @relation(fields: [companyId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([companyId, userId])
}

enum CompanyUserRole {
  ADMIN
  ACCOUNTANT
  EMPLOYEE
}

model Document {
  id String @id @default(uuid())
  type DocumentType @default(ESTIMATE)
  companyId String
  clientName String
  clientEmail String
  clientAddress String
  clientCity String
  clientPostalCode String
  clientCountry String
  totalPriceExcludingTax Float
  totalPrice Float
  createdAt DateTime @default(now())
  sentAt DateTime?
  documentNumber String?
  versionNumber Int @default(1)
  isLastVersion Boolean @default(true)
  isFromEstimate Boolean? @default(true)
  sourceDocumentId String?
  sourceDocument Document? @relation("DocumentConversion", fields: [sourceDocumentId], references: [id], onDelete: Restrict)

  convertedDocuments Document[] @relation("DocumentConversion")

  urlDocumentPdf String?
  paymentDueAt DateTime
  invoiceStatus InvoiceStatus @default(DRAFT)
  estimateStatus EstimateStatus @default(DRAFT)

  @@unique([companyId, documentNumber, versionNumber])
  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  services DocumentService[]
  negociations EstimateNegociation[]
  invoicePaymentLinkSessions InvoicePaymentLinkSession[] // peut en créer plusieurs pour un même document, mais seulement un actif à la fois
  invoicePaymentPlan InvoicePaymentPlan?
  invoicePaymentFee InvoicePaymentFee?
}

enum DocumentType {
  ESTIMATE
  INVOICE
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAYMENT_IN_PROGRESS
  PAID
  PARTIALLY_PAID
  PAID_MANUALLY
  OVERDUE
  REJECTED
}

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  SUPERSEDED
  REJECTED
}

model EstimateNegociation {
  id String @id @default(uuid())
  documentId String
  message String
  proposedTotalPrice Float
  createdAt DateTime @default(now())
  negociationToken String @unique
  status EstimateNegociationStatus @default(PENDING)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

enum EstimateNegociationStatus {
  PENDING
  ACCEPTED
  RENEGOCIATED
  REJECTED
}

model InvoicePaymentFee {
  id String @id @default(uuid())
  documentId String @unique
  companyId String
  amountInCents Int
  paymentMethod PaymentMethod? @default(BANK_TRANSFER)
  createdAt DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id])
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

enum PaymentMethod {
  CREDIT_CARD
  BANK_TRANSFER
  CHECK
  CASH
  OTHER
}

enum PaymentProvider {
  BRIDGE
  GOCARDLESS
}

model InvoicePaymentLinkSession {
  id String @id @default(uuid())
  invoiceId String
  paymentLinkId String @unique
  paymentAccessToken String @unique
  linkStatus InvoicePaymentLinkStatus?
  paymentStatus InvoicePaymentStatus
  url String
  invoicePaymentInstallmentId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  invoice Document @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoicePaymentAttempts InvoicePaymentAttempt[]
  invoicePaymentInstallment InvoicePaymentInstallment? @relation(fields: [invoicePaymentInstallmentId], references: [id], onDelete: Cascade)
}

enum InvoicePaymentLinkStatus {
  VALID
  COMPLETED
  EXPIRED
  REVOKED
}

enum InvoicePaymentStatus {
  PENDING
  PAYMENT_IN_PROGRESS
  SUCCESS
  FAILED
}

model InvoicePaymentAttempt {
  id String @id @default(uuid())
  invoicePaymentLinkSessionId String
  paymentRequestId String?
  paymentTransactionId String @unique
  paymentTransactionStatus InvoicePaymentAttemptStatus?
  paymentTransactionErrorStatusReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoicePaymentLinkSession InvoicePaymentLinkSession @relation(fields: [invoicePaymentLinkSessionId], references: [id], onDelete: Cascade)
}

enum InvoicePaymentAttemptStatus {
  PENDING
  PAYMENT_IN_PROGRESS
  SUCCESS
  FAILED
}

// Pour paiement en plusieurs échéances
model InvoicePaymentPlan {
  id String @id @default(uuid())
  invoiceId String @unique
  totalAmountInCents Int
  numberOfInstallments Int
  amountPerInstallmentInCents Int
  isCompleted Boolean @default(false)

  invoice Document @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoicePaymentInstallments InvoicePaymentInstallment[]
}

model InvoicePaymentInstallment {
  id String @id @default(uuid())
  invoicePaymentPlanId String
  installmentNumber Int
  amountInCents Int
  dueDate DateTime
  installmentStatus InvoicePaymentInstallmentStatus @default(PENDING)
  paidAt DateTime?

  invoicePaymentPlan InvoicePaymentPlan @relation(fields: [invoicePaymentPlanId], references: [id], onDelete: Cascade)
  invoicePaymentLinkSessions InvoicePaymentLinkSession[] // peut en créer plusieurs pour un même échéancier, mais seulement un actif à la fois
}

enum InvoicePaymentInstallmentStatus {
  PENDING
  PAYMENT_IN_PROGRESS
  SUCCESS
  FAILED
  OVERDUE
}

model DocumentService {
  id String @id @default(uuid())
  documentId String
  description String
  quantity Int
  unitPrice Float
  unit String
  taxRate Float?
  wtPrice Float
  totalPrice Float

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model CompanyService {
  id String @id @default(uuid())
  companyId String
  name String
  description String
  unitPrice Float
  unit String
  taxRate Float?
  category String
  wtPrice Float
  totalPrice Float

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model CompanyClient {
  id String @id @default(uuid())
  companyId String
  name String
  email String
  address String
  city String
  postalCode String
  country String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}
