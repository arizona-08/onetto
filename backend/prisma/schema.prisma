// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String            @id @default(uuid())
  firstname              String
  lastname               String
  email                  String            @unique
  password               String
  emailVerifiedAt        DateTime?
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  passwordResetTokenHash  String?
  passwordResetExpiresAt  DateTime?
  passwordChangedAt       DateTime?
  accountType            AccountType       @default(BUSINESS_OWNER)
  subscriptionPlan       SubscriptionPlan?
  lastConnectedCompanyId String?

  lastConnectedCompany Company?                  @relation("LastConnectedCompany", fields: [lastConnectedCompanyId], references: [id])
  ownedCompanies       Company[]
  companies            CompanyUser[]
  subscription         UserSubscription?
  subscriptionHistory  UserSubscriptionHistory[]
  notifications        AppNotification[]
}

enum AccountType {
  BUSINESS_OWNER
  EMPLOYEE
}

model UserSubscription {
  id                    String           @id @default(uuid())
  userId                String           @unique
  user                  User             @relation(fields: [userId], references: [id])
  customerId            String?          @unique
  subscriptionId        String?
  subscriptionPlan      SubscriptionPlan @default(FREE)
  isActive              Boolean          @default(true)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  canceledAtPeriodEnd   DateTime?
  willCancelAtPeriodEnd Boolean          @default(false)
}

model UserSubscriptionHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  subscriptionPlan SubscriptionPlan
}

enum SubscriptionPlan {
  FREE
  STARTER_MONTHLY
  STARTER_YEARLY
  PRO_MONTHLY
  PRO_YEARLY
}

model Company {
  id                        String            @id @default(uuid())
  ownerId                   String
  name                      String
  email                     String            @unique
  phoneNumber               String            @unique
  siren                     String            @unique
  siret                     String            @unique
  address                   String
  city                      String
  postalCode                String
  country                   String
  subjectToVat              Boolean
  vatNumber                 String?
  IBAN                      String
  BIC                       String
  status                    CompanyStatus     @default(ACTIVE)
  closingReason             String?
  closedAt                  DateTime?
  isPaymentAccountConnected Boolean           @default(false)
  legalForm                 String?
  legalStatus               CompanyLegalStatus @default(MICRO_ENTERPRISE)
  vatRegime                 CompanyVatRegime   @default(VAT_EXEMPTION)
  isVatExempt               Boolean             @default(true)
  hasVatOnDebits            Boolean           @default(false)
  vatExigibility            CompanyVatExigibility @default(UNKNOWN)
  electronicAddress         String
  electronicAddressScheme   CompanyElectronicAddressScheme @default(SIREN)

  documents                      Document[]
  owner                          User                            @relation(fields: [ownerId], references: [id])
  companyUsers                   CompanyUser[]
  lastConnectedUsers             User[]                          @relation("LastConnectedCompany")
  services                       CompanyService[]
  clients                        CompanyClient[]
  companyPaymentAccount          CompanyPaymentAccount?
  companyPaymentOAuthStates      CompanyPaymentOAuthState[]
  electronicInvoicingConnection  ElectronicInvoicingConnection?
  electronicInvoicingOAuthStates ElectronicInvoicingOAuthState[]
  receivedElectronicInvoices     ReceivedElectronicInvoice[]
  electronicReportingSubmissions ElectronicReportingSubmission[]
  notifications                   AppNotification[]
}

enum AppNotificationType {
  SUPPLIER_INVOICE_RECEIVED
  PAYMENT_SUBMITTED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  ESTIMATE_ACCEPTED
  ESTIMATE_RENEGOTIATED
  ESTIMATE_REJECTED
}

model AppNotification {
  id               String              @id @default(uuid())
  userId           String
  companyId        String
  type             AppNotificationType
  title            String
  message          String
  href             String?
  deduplicationKey String
  metadata         Json?
  readAt           DateTime?
  createdAt        DateTime            @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, deduplicationKey])
  @@index([userId, readAt, createdAt])
  @@index([companyId, createdAt])
}

enum CompanyVatRegime {
  MONTHLY
  QUARTERLY
  SIMPLIFIED
  VAT_EXEMPTION
}

enum CompanyLegalStatus {
  MICRO_ENTERPRISE
  INDIVIDUAL_ENTREPRENEUR
  EIRL
  EURL
  SARL
  SELARL
  SASU
  SAS
  SELAS
  SA
  SELAFA
  SCA
  SELCA
  SNC
  SCS
  SLP
  SOCIETE_CIVILE
  SCI
  SCM
  SCP
  EARL
  GAEC
  SCEA
  GIE
  ASSOCIATION
  FONDATION
  MUTUELLE
  COOPERATIVE
  ETABLISSEMENT_PUBLIC
  COLLECTIVITE_TERRITORIALE
  SOCIETE_ETRANGERE
  OTHER
}

enum CompanyElectronicAddressScheme {
  SIREN
  SIRET
  VAT
  GLN
  PEPPOL
}

enum CompanyStatus {
  ACTIVE
  CLOSED
}

model CompanyPaymentAccount {
  id                 String                                  @id @default(uuid())
  companyId          String                                  @unique
  provider           PaymentProvider
  providerAccountId  String
  accessToken        String
  creditorId         String?
  verificationStatus CompanyPaymentAccountVerificationStatus @default(NOT_VERIFIED)

  company Company @relation(fields: [companyId], references: [id])
}

enum CompanyPaymentAccountVerificationStatus {
  NOT_VERIFIED
  IN_REVIEW
  VERIFIED
}

model CompanyPaymentOAuthState {
  id        String   @id @default(uuid())
  companyId String
  state     String   @unique
  expiresAt DateTime

  company Company @relation(fields: [companyId], references: [id])
}

model CompanyUser {
  id        String          @id @default(uuid())
  companyId String
  userId    String
  role      CompanyUserRole
  isHidden  Boolean         @default(false)

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([companyId, userId])
}

enum CompanyUserRole {
  ADMIN
  ACCOUNTANT
  EMPLOYEE
}

model Document {
  id                      String                            @id @default(uuid())
  type                    DocumentType                      @default(ESTIMATE)
  companyId               String
  clientName              String
  clientEmail             String
  clientAddress           String
  clientCity              String
  clientPostalCode        String
  clientCountry           String
  clientType              ElectronicInvoiceClientType?
  clientIsVatTaxable      Boolean?
  clientSiren             String?
  clientVatNumber         String?
  clientElectronicAddress String?
  clientElectronicAddressScheme String?
  clientForeignIdentifier String?
  deliveryAddress         String?
  deliveryCity            String?
  deliveryPostalCode      String?
  deliveryCountry         String?
  currencyCode            String                            @default("EUR")
  operationNature         ElectronicInvoiceOperationNature?
  isVatExempt             Boolean                           @default(false)
  vatExemptionReason      String?
  totalPriceExcludingTax  Float
  totalPrice              Float
  createdAt               DateTime                          @default(now())
  sentAt                  DateTime?
  documentNumber          String?
  versionNumber           Int                               @default(1)
  isLastVersion           Boolean                           @default(true)
  isFromEstimate          Boolean?                          @default(true)
  sourceDocumentId        String?
  sourceDocument          Document?                         @relation("DocumentConversion", fields: [sourceDocumentId], references: [id], onDelete: Restrict)

  convertedDocuments Document[] @relation("DocumentConversion")

  urlDocumentPdf                 String?
  facturXContent                 Bytes?
  facturXGeneratedAt             DateTime?
  answerDueAt                    DateTime?                       @default(now())
  paymentDueAt                   DateTime
  invoiceStatus                  InvoiceStatus                   @default(DRAFT)
  estimateStatus                 EstimateStatus                  @default(DRAFT)
  company                        Company                         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  services                       DocumentService[]
  negociations                   EstimateNegociation[]
  invoicePaymentLinks            InvoicePaymentLink[]
  payByBankPayments              PayByBankPayment[]
  invoiceInstalmentPlan          InvoiceInstalmentPlan?
  invoicePaymentMode             InvoicePaymentMode?
  invoicePublicAccess            InvoicePublicAccess?
  processedReminders             ProcessedReminders[]
  electronicInvoiceTransmissions ElectronicInvoiceTransmission[]
  electronicReportingSubmissions ElectronicReportingSubmission[]

  @@unique([companyId, documentNumber, versionNumber])
}

enum ElectronicInvoiceClientType {
  INDIVIDUAL
  BUSINESS
  PUBLIC_BODY
  FOREIGN
}

enum ElectronicInvoiceOperationNature {
  GOODS
  SERVICES
  MIXED
}

enum ElectronicInvoiceLineItemType {
  GOODS
  SERVICES
}

enum CompanyVatExigibility {
  UNKNOWN
  ON_COLLECTION
  ON_DEBITS
}

enum DocumentType {
  ESTIMATE
  INVOICE
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAYMENT_IN_PROGRESS
  PAID
  PARTIALLY_PAID
  PAID_MANUALLY
  OVERDUE
  REJECTED
}

enum EstimateStatus {
  DRAFT
  SENT
  ACCEPTED
  SUPERSEDED
  REJECTED
}

model EstimateNegociation {
  id                 String                    @id @default(uuid())
  documentId         String
  message            String
  proposedTotalPrice Float
  createdAt          DateTime                  @default(now())
  negociationToken   String                    @unique
  status             EstimateNegociationStatus @default(PENDING)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

enum EstimateNegociationStatus {
  PENDING
  ACCEPTED
  RENEGOCIATED
  REJECTED
}

// doit générer un InvoiceInstalmentPlan si INSTALMENTS
model InvoicePaymentMode {
  id                         String                @id @default(uuid())
  invoiceId                  String                @unique
  paymentMode                PaymentMode           @default(ONE_TIME)
  paymentModeFrequency       PaymentModeFrequency?
  numberOfInstalments        Int?
  amountPerInstalmentInCents Int?

  invoice Document @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

enum PaymentMode {
  ONE_TIME
  INSTALMENTS
}

enum PaymentModeFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum PaymentProvider {
  BRIDGE
  GOCARDLESS
}

model InvoicePublicAccess {
  id        String @id @default(uuid())
  invoiceId String @unique

  invoicePaymentLinkId String             @unique
  invoicePaymentLink   InvoicePaymentLink @relation(fields: [invoicePaymentLinkId], references: [id], onDelete: Cascade)

  accessToken String   @unique
  expiresAt   DateTime

  invoice Document @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model InvoicePaymentLink {
  id String @id @default(uuid())

  invoiceId String
  invoice   Document @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  url String

  provider          PaymentProvider @default(BRIDGE)
  providerReference String          @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  linkStatus        InvoicePaymentLinkStatus? @default(VALID)
  publicAccess      InvoicePublicAccess?
  payByBankPayments PayByBankPayment[]
}

enum InvoicePaymentLinkStatus {
  VALID
  COMPLETED
  EXPIRED
  REVOKED
  FAILED
}

model PayByBankPayment {
  id String @id @default(uuid())

  invoiceId String
  invoice   Document @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  invoicePaymentLinkId String?
  invoicePaymentLink   InvoicePaymentLink? @relation(fields: [invoicePaymentLinkId], references: [id], onDelete: Cascade)

  amountInCents     Int // Bridge l'attend en euros, mais on stocke en centimes pour éviter les problèmes d'arrondi
  provider          PaymentProvider      @default(BRIDGE)
  providerReference String               @unique
  status            InvoicePaymentStatus @default(PENDING)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  payByBankPaymentAttempts PayByBankPaymentAttempt[]
}

enum InvoicePaymentStatus {
  PENDING
  PAYMENT_IN_PROGRESS
  SUCCESS
  FAILED
}

model PayByBankPaymentAttempt {
  id String @id @default(uuid())

  payByBankPaymentId String
  payByBankPayment   PayByBankPayment @relation(fields: [payByBankPaymentId], references: [id], onDelete: Cascade)

  providerReference String                       @unique
  providerPaymentId String
  paymentStatus     InvoicePaymentAttemptStatus? @default(PENDING)
  failureReason     String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@unique([providerReference, providerPaymentId])
}

enum InvoicePaymentAttemptStatus {
  PENDING
  PAYMENT_IN_PROGRESS
  SUCCESS
  FAILED
}

model ProcessedWebhookEvents {
  id              String          @id @default(uuid())
  provider        PaymentProvider
  providerEventId String
  processedAt     DateTime        @default(now())

  @@unique([provider, providerEventId])
}

model ProcessedStripeWebhookEvents {
  id              String   @id @default(uuid())
  providerEventId String
  processedAt     DateTime @default(now())

  @@unique([providerEventId])
}

// Pour paiement en plusieurs échéances
model InvoiceInstalmentPlan {
  id                         String   @id @default(uuid())
  invoiceId                  String   @unique
  totalAmountInCents         Int
  numberOfInstalments        Int
  amountPerInstalmentInCents Int
  startDate                  DateTime @default(now())
  authorizationDeadline      DateTime
  providerReference          String   @unique
  providerScheduledId        String?
  providerMandateId          String?
  isCompleted                Boolean  @default(false)

  invoice                   Document                   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoicePaymentInstalments InvoicePaymentInstalment[]
}

model InvoicePaymentInstalment {
  id String @id @default(uuid())

  invoiceInstalmentPlanId String
  invoiceInstalmentPlan   InvoiceInstalmentPlan          @relation(fields: [invoiceInstalmentPlanId], references: [id], onDelete: Cascade)
  providerPaymentId       String?                        @unique
  instalmentNumber        Int
  amountInCents           Int
  dueDate                 DateTime
  instalmentStatus        InvoicePaymentInstalmentStatus @default(PENDING)
  automaticRetryScheduled Boolean                        @default(false)
  paidAt                  DateTime?
  processedReminders      ProcessedInstalmentReminder[]

  @@unique([invoiceInstalmentPlanId, instalmentNumber])
}

enum InvoicePaymentInstalmentStatus {
  PENDING
  PAYMENT_IN_PROGRESS
  SUCCESS
  FAILED
  OVERDUE
}

model DocumentService {
  id          String @id @default(uuid())
  documentId  String
  description String
  quantity    Int
  unitPrice   Float
  unit        String
  taxRate     Float?
  wtPrice     Float
  totalPrice  Float
  itemType    ElectronicInvoiceLineItemType @default(SERVICES)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model CompanyService {
  id          String @id @default(uuid())
  companyId   String
  name        String
  description String
  unitPrice   Float
  unit        String
  taxRate     Float?
  category    String
  wtPrice     Float
  totalPrice  Float
  itemType    ElectronicInvoiceLineItemType @default(SERVICES)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model CompanyClient {
  id         String            @id @default(uuid())
  companyId  String
  name       String
  email      String
  address    String
  city       String
  postalCode String
  country    String
  clientType CompanyClientType @default(CLIENT)
  siren      String?
  vatNumber  String?
  electronicAddress String?
  electronicAddressScheme String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

enum CompanyClientType {
  BUSINESS
  CLIENT
}

enum ElectronicInvoicingProvider {
  SUPER_PDP
}

enum ElectronicInvoicingEnvironment {
  SANDBOX
  PRODUCTION
}

enum ElectronicInvoicingConnectionStatus {
  NOT_CONFIGURED
  PENDING_AUTHORIZATION
  VERIFYING
  ACTIVE
  ACTION_REQUIRED
  SUSPENDED
}

enum ElectronicDirectoryRegistrationStatus {
  UNKNOWN
  PENDING
  ACTIVE
  NOT_REGISTERED
}

enum ElectronicInvoiceFlow {
  B2B_FR
  B2C_FR
  B2B_INTERNATIONAL
  B2G
  EXEMPT
  OUT_OF_SCOPE
}

enum ElectronicInvoiceTransmissionStatus {
  PENDING
  SUBMITTING
  SUBMITTED
  SENT
  DELIVERED
  ACCEPTED
  PARTIALLY_ACCEPTED
  DISPUTED
  ON_HOLD
  COMPLETED
  REFUSED
  REJECTED
  INVALID
  FAILED
}

enum ElectronicInvoiceEventSource {
  PROVIDER_SYNC
  WEBHOOK
  USER_ACTION
  PAYMENT
}

enum ReceivedElectronicInvoiceStatus {
  AVAILABLE
  ACCEPTED
  PARTIALLY_ACCEPTED
  DISPUTED
  ON_HOLD
  COMPLETED
  REFUSED
  REJECTED
}

enum ElectronicReportingKind {
  TRANSACTION
  PAYMENT
}

enum ElectronicReportingStatus {
  PENDING
  SUBMITTING
  SUBMITTED
  ACCEPTED
  REJECTED
  FAILED
}

model ElectronicInvoicingConnection {
  id                          String                                @id @default(uuid())
  companyId                   String                                @unique
  provider                    ElectronicInvoicingProvider
  environment                 ElectronicInvoicingEnvironment
  providerCompanyId           String?
  accessTokenEncrypted        String?
  refreshTokenEncrypted       String?
  accessTokenExpiresAt        DateTime?
  status                      ElectronicInvoicingConnectionStatus   @default(NOT_CONFIGURED)
  directoryRegistrationStatus ElectronicDirectoryRegistrationStatus @default(UNKNOWN)
  enabledCapabilities         Json?
  connectedAt                 DateTime?
  lastSyncedAt                DateTime?
  lastError                   String?
  metadata                    Json?
  createdAt                   DateTime                              @default(now())
  updatedAt                   DateTime                              @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([provider, environment, status])
}

model ElectronicInvoicingOAuthState {
  id        String   @id @default(uuid())
  companyId String
  state     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, expiresAt])
}

model ElectronicInvoiceTransmission {
  id                  String                              @id @default(uuid())
  documentId          String
  provider            ElectronicInvoicingProvider
  providerInvoiceId   String?
  flow                ElectronicInvoiceFlow
  status              ElectronicInvoiceTransmissionStatus @default(PENDING)
  providerStatus      String?
  submittedFormat     String?
  documentFingerprint String?
  idempotencyKey      String                              @unique
  attemptCount        Int                                 @default(0)
  submittedAt         DateTime?
  lastSyncedAt        DateTime?
  lastError           String?
  createdAt           DateTime                            @default(now())
  updatedAt           DateTime                            @updatedAt

  document Document                 @relation(fields: [documentId], references: [id], onDelete: Restrict)
  events   ElectronicInvoiceEvent[]

  @@unique([documentId, provider, flow])
  @@unique([provider, providerInvoiceId])
  @@index([status, lastSyncedAt])
}

model ElectronicInvoiceEvent {
  id              String                       @id @default(uuid())
  transmissionId  String
  providerEventId String
  type            String
  providerStatus  String
  source          ElectronicInvoiceEventSource
  occurredAt      DateTime
  receivedAt      DateTime                     @default(now())
  payload         Json?

  transmission ElectronicInvoiceTransmission @relation(fields: [transmissionId], references: [id], onDelete: Cascade)

  @@unique([transmissionId, providerEventId])
  @@index([transmissionId, occurredAt])
}

model ReceivedElectronicInvoice {
  id                  String                          @id @default(uuid())
  companyId           String
  provider            ElectronicInvoicingProvider
  providerInvoiceId   String
  supplierSiren       String?
  supplierName        String?
  invoiceNumber       String?
  issuedAt            DateTime?
  dueAt               DateTime?
  currencyCode        String
  totalExcludingTax   Decimal                         @db.Decimal(18, 4)
  totalVat            Decimal                         @db.Decimal(18, 4)
  totalIncludingTax   Decimal                         @db.Decimal(18, 4)
  status              ReceivedElectronicInvoiceStatus @default(AVAILABLE)
  providerStatus      String?
  documentFormat      String?
  providerDocumentUrl String?
  documentFingerprint String?
  metadata            Json?
  receivedAt          DateTime                        @default(now())
  lastSyncedAt        DateTime?
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider, providerInvoiceId])
  @@index([companyId, status, issuedAt])
}

model ElectronicReportingSubmission {
  id                 String                      @id @default(uuid())
  companyId          String
  documentId         String?
  provider           ElectronicInvoicingProvider
  kind               ElectronicReportingKind
  periodStart        DateTime
  periodEnd          DateTime
  providerReportId   String?
  status             ElectronicReportingStatus   @default(PENDING)
  providerStatus     String?
  idempotencyKey     String                      @unique
  payloadFingerprint String
  sourcePaymentReference String?
  submittedAt        DateTime?
  acceptedAt         DateTime?
  lastError          String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerReportId])
  @@unique([provider, sourcePaymentReference])
  @@index([companyId, kind, periodStart, periodEnd])
}

model ProcessedReminders {
  id           String       @id @default(uuid())
  documentId   String
  document     Document     @relation(fields: [documentId], references: [id])
  reminderType ReminderType
  processedAt  DateTime     @default(now())

  @@unique([documentId, reminderType])
}

model ProcessedInstalmentReminder {
  id           String                   @id @default(uuid())
  instalmentId String
  instalment   InvoicePaymentInstalment @relation(fields: [instalmentId], references: [id], onDelete: Cascade)
  reminderType ReminderType
  processedAt  DateTime                 @default(now())

  @@unique([instalmentId, reminderType])
}

enum ReminderType {
  ESTIMATE_PENDING
  ESTIMATE_PENDING_BEFORE_DUE_DATE
  INVOICE_BEFORE_DUE_DATE
  INVOICE_OVERDUE_FIRST
  INVOICE_OVERDUE_SECOND
  INSTALMENT_MANDATE_AFTER_ISSUE
  INSTALMENT_MANDATE_BEFORE_AUTHORIZATION_DEADLINE
  INSTALMENT_PAYMENT_OVERDUE
}
